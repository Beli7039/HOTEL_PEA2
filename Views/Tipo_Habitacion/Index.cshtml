@model IEnumerable<HOTEL_PEA2.Models.Tipo_Habitacion>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Tipos de Habitación";
}

<link rel="stylesheet" href="~/css/clientes.css" />

<div class="clientes-container">
    <div class="clientes-header">
        <div class="titulo">
            <div class="icon-header"><i class="fa-solid fa-list"></i></div>
            <div><h1>Tipos de Habitación</h1><p>Inicio / Tipos</p></div>
        </div>
        <a asp-action="Create" class="btn-nuevo"><i class="fa-solid fa-plus"></i> Nuevo Tipo</a>
    </div>

    <div class="card">
        <div class="card-title">LISTA DE TIPOS</div>
        <table class="tabla-clientes">
            <thead>
                <tr><th>ID</th><th>Nombre</th><th>Descripción</th><th>Precio Base</th><th>Capacidad</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.IdTipoHabitacion</td>
                        <td>@t.NombreTipo</td>
                        <td>@t.Descripcion</td>
                        <td>S/. @t.PrecioBase</td>
                        <td>@t.Capacidad</td>
                        <td style="display:flex; gap:6px;">
                            <a asp-action="Edit" asp-route-id="@t.IdTipoHabitacion" class="btn-guardar" style="background:#ffc107;color:#000;"><i class="fa-solid fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@t.IdTipoHabitacion" class="btn-guardar" style="background:#0d6efd;"><i class="fa-solid fa-eye"></i></a>
                            <a asp-action="Delete" asp-route-id="@t.IdTipoHabitacion" class="btn-guardar" style="background:#dc3545;"><i class="fa-solid fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>