@model HOTEL_PEA2.Models.Tipo_Habitacion
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/clientes.css" />

<div class="clientes-container">
    <div class="card">
        <div class="card-title">DETALLES DEL TIPO</div>
        <dl class="form-grid">
            <div><dt>ID</dt><dd>@Model.IdTipoHabitacion</dd></div>
            <div><dt>Nombre</dt><dd>@Model.NombreTipo</dd></div>
            <div><dt>Descripción</dt><dd>@Model.Descripcion</dd></div>
            <div><dt>Precio Base</dt><dd>S/. @Model.PrecioBase</dd></div>
            <div><dt>Capacidad</dt><dd>@Model.Capacidad</dd></div>
        </dl>
        <div class="botones">
            <a asp-action="Edit" asp-route-id="@Model.IdTipoHabitacion" class="btn-guardar"><i class="fa-solid fa-pen"></i> Editar</a>
            <a asp-action="Index" class="btn-cancelar"><i class="fa-solid fa-arrow-left"></i> Volver</a>
        </div>
    </div>
</div>