@model HOTEL_PEA2.Models.Tipo_Habitacion
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/clientes.css" />

<div class="clientes-container">
    <div class="card">
        <div class="card-title">REGISTRO DE TIPO</div>
        <form asp-action="Create" method="post">
            <div class="form-grid">
                <div><label>Nombre</label><input asp-for="NombreTipo" /></div>
                <div><label>Descripción</label><input asp-for="Descripcion" /></div>
                <div><label>Precio Base</label><input asp-for="PrecioBase" type="number" step="0.01" /></div>
                <div><label>Capacidad</label><input asp-for="Capacidad" type="number" /></div>
            </div>
            <div class="botones">
                <a asp-action="Index" class="btn-cancelar"><i class="fa-solid fa-xmark"></i> Cancelar</a>
                <button type="submit" class="btn-guardar"><i class="fa-regular fa-floppy-disk"></i> Guardar</button>
            </div>
        </form>
    </div>
</div>