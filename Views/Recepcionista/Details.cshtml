@model HOTEL_PEA2.Models.Recepcionista
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/clientes.css" />

<div class="clientes-container">
    <div class="card">
        <div class="card-title">DETALLES DEL RECEPCIONISTA</div>
        <dl class="form-grid">
            <div><dt>ID</dt><dd>@Model.IdRecepcionista</dd></div>
            <div><dt>Nombres</dt><dd>@Model.Nombres @Model.Apellidos</dd></div>
            <div><dt>Usuario</dt><dd>@Model.Usuario</dd></div>
            <div><dt>Teléfono</dt><dd>@Model.Telefono</dd></div>
            <div><dt>Email</dt><dd>@Model.Email</dd></div>
            <div><dt>Estado</dt><dd>@Model.Estado</dd></div>
        </dl>
        <div class="botones">
            <a asp-action="Edit" asp-route-id="@Model.IdRecepcionista" class="btn-guardar"><i class="fa-solid fa-pen"></i> Editar</a>
            <a asp-action="Index" class="btn-cancelar"><i class="fa-solid fa-arrow-left"></i> Volver</a>
        </div>
    </div>
</div>