@{
    var controlador = ViewContext.RouteData.Values["Controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ProyectoHotel</title>

    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

</head>

<body>

    <div class="sidebar">

        <div>

            <div class="logo">
                <img src="~/img/LogoFormulario.png" />
            </div>
            <div class="menu">

                <a asp-controller="Home"
                   asp-action="Dashboard"
                   class="menu-item @(controlador == "Home" ? "active" : "")">

                    <i class="fa-solid fa-border-all"></i>
                    <span>Dashboard</span>

                </a>

                <a asp-controller="Reserva"
                   asp-action="Index"
                   class="menu-item @(controlador == "Reserva" ? "active" : "")">

                    <i class="fa-regular fa-calendar-days"></i>
                    <span>Reservas</span>

                </a>

                <a asp-controller="Habitacion" asp-action="Index"
                   class="menu-item @(controlador == "Habitacion" ? "active" : "")">
                    <i class="fa-solid fa-bed"></i>
                    <span>Habitaciones</span>
                </a>

                <a asp-controller="Cliente"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Cliente" ? "active" : "")">

                    <i class="fa-regular fa-user"></i>
                    <span>Clientes</span>

                </a>

                <a asp-controller="Recepcionista" asp-action="Index"
                   class="menu-item @(controlador == "Recepcionista" ? "active" : "")">
                    <i class="fa-solid fa-users"></i>
                    <span>Recepcionistas</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                    <span>Check-In</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    <span>Check-Out</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span>Servicios</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="fa-regular fa-credit-card"></i>
                    <span>Pagos</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="fa-regular fa-file-lines"></i>
                    <span>Facturación</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="fa-solid fa-chart-column"></i>
                    <span>Reportes</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="fa-solid fa-gear"></i>
                    <span>Configuración</span>
                </a>

            </div>

        </div>


        <div class="logout">

            <a asp-controller="Login" asp-action="Index">

                <i class="fa-solid fa-right-from-bracket"></i>
                <span>Cerrar sesión</span>

            </a>

        </div>

    </div>

    <div class="main-content">

        @RenderBody()

    </div>

    @RenderSection("Scripts", required: false)

</body>
</html>