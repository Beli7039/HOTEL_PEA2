@model IEnumerable<HOTEL_PEA2.Models.Cliente>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Clientes";
}

<link rel="stylesheet" href="~/css/clientes.css" asp-append-version="true" />

<div class="clientes-container">

    @* ============================================================
       ENCABEZADO
       ============================================================ *@
    <div class="clientes-header">
        <div class="titulo">
            <div class="icon-header">
                <i class="fa-solid fa-users"></i>
            </div>
            <div>
                <h1>Clientes</h1>
                <p>Inicio / Clientes</p>
            </div>
        </div>
        <a asp-action="Create" class="btn-nuevo">
            <i class="fa-solid fa-plus"></i> Nuevo Cliente
        </a>
    </div>

    @* ============================================================
       TARJETA CON TABLA
       ============================================================ *@
    <div class="card">
        <div class="card-title">LISTA DE CLIENTES</div>

        @* --- Barra de búsqueda --- *@
        <form asp-action="Index" method="get" class="barra-busqueda">
            <div class="input-busqueda">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="criterio" value="@ViewBag.Criterio"
                       placeholder="Buscar por DNI, nombres o apellidos..." />
            </div>
            <button type="submit" class="btn-buscar">
                <i class="fa-solid fa-search"></i> Buscar
            </button>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Criterio as string))
            {
                <a asp-action="Index" class="btn-limpiar">
                    <i class="fa-solid fa-xmark"></i> Limpiar
                </a>
            }
        </form>

        @* --- Tabla o mensaje vacío --- *@
        @if (!Model.Any())
        {
            <div class="sin-registros">
                <i class="fa-solid fa-inbox"></i>
                <p>No hay clientes registrados.</p>
            </div>
        }
        else
        {
            <div class="tabla-wrapper">
                <table class="tabla-clientes">
                    <thead>
                        <tr>
                            <th class="col-id">ID</th>
                            <th class="col-dni">DNI</th>
                            <th class="col-nombre">Nombre Completo</th>
                            <th class="col-telefono">Teléfono</th>
                            <th class="col-email">Email</th>
                            <th class="col-fecha">Registro</th>
                            <th class="col-estado">Estado</th>
                            <th class="col-acciones">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="col-id">@c.IdCliente</td>
                                <td class="col-dni">
                                    <span class="dni-badge">@c.Dni</span>
                                </td>
                                <td class="col-nombre">
                                    <div class="nombre-cliente">
                                        <span class="avatar">
                                            @(c.Nombres?.Substring(0, 1).ToUpper() ?? "?")
                                        </span>
                                        <span>@c.Apellidos, @c.Nombres</span>
                                    </div>
                                </td>
                                <td class="col-telefono">
                                    @if (!string.IsNullOrWhiteSpace(c.Telefono))
                                    {
                                        <i class="fa-solid fa-phone icon-inline"></i>
                                        @c.Telefono
                                    }
                                    else
                                    {
                                        <span class="texto-vacio">—</span>
                                    }
                                </td>
                                <td class="col-email">
                                    @if (!string.IsNullOrWhiteSpace(c.Email))
                                    {
                                        <i class="fa-solid fa-envelope icon-inline"></i>
                                        @c.Email
                                    }
                                    else
                                    {
                                        <span class="texto-vacio">—</span>
                                    }
                                </td>
                                <td class="col-fecha">
                                    @c.FechaRegistro.ToString("dd/MM/yyyy")
                                </td>
                                <td class="col-estado">
                                    <span class="estado-badge estado-@(c.Estado?.ToLower())">
                                        @c.Estado
                                    </span>
                                </td>
                                <td class="col-acciones">
                                    <div class="acciones">
                                        <a asp-action="Edit" asp-route-id="@c.IdCliente"
                                           class="btn-accion btn-editar" title="Editar">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@c.IdCliente"
                                           class="btn-accion btn-detalle" title="Ver detalles">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@c.IdCliente"
                                           class="btn-accion btn-eliminar" title="Eliminar">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>