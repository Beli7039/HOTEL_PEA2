@model IEnumerable<HOTEL_PEA2.Models.Cliente>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Clientes";
}

<link rel="stylesheet" href="~/css/clientes.css" />

<div class="clientes-container">

    <div class="clientes-header">
        <div class="titulo">
            <div class="icon-header">
                <i class="fa-solid fa-users"></i>
            </div>
            <div>
                <h1>Clientes</h1>
                <p>Inicio / Clientes</p>
            </div>
        </div>

        <a asp-action="Create" class="btn-nuevo">
            <i class="fa-solid fa-plus"></i>
            Nuevo Cliente
        </a>
    </div>

    <div class="card">

        <div class="card-title">LISTA DE CLIENTES</div>

        <form asp-action="Index" method="get" class="tabla-top">
            <div>
                Mostrar
                <select disabled>
                    <option>10</option>
                </select>
                registros
            </div>

            <div style="display:flex; gap:8px;">
                <input type="text" name="buscar" value="@ViewBag.Buscar"
                       placeholder="Buscar cliente..." />
                <button type="submit" class="btn-guardar">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </form>

        <table class="tabla-clientes">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>DNI</th>
                    <th>NOMBRES</th>
                    <th>TELÉFONO</th>
                    <th>ESTADO</th>
                    <th>ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IdCliente</td>
                            <td>@item.Dni</td>
                            <td>@item.Nombres @item.Apellidos</td>
                            <td>@item.Telefono</td>
                            <td>@item.Estado</td>
                            <td style="display:flex; gap:6px;">
                                <a asp-action="Edit" asp-route-id="@item.IdCliente"
                                   class="btn-guardar" style="background:#ffc107;color:#000;">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.IdCliente"
                                   class="btn-guardar" style="background:#0d6efd;">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.IdCliente"
                                   class="btn-guardar" style="background:#dc3545;">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="sin-datos">
                            Aún no hay clientes registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>