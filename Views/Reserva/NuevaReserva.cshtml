@model HOTEL_PEA2.Models.ViewModels.ReservaViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Nueva Reserva";
}
<link rel="stylesheet" href="~/css/reserva.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />

<partial name="_Header" />

<section class="page-header">
    <div class="title-section">
        <div class="title-icon"><i class="fa-regular fa-calendar-days"></i></div>
        <div>
            <h1>Reservas</h1>
            <nav class="breadcrumb">
                <span>Inicio</span> / <span>Reservas</span> / <strong>Nueva Reserva</strong>
            </nav>
        </div>
    </div>

    <div class="header-buttons">
        <a asp-action="Index" class="btn btn-cancelar">
            <i class="fa-solid fa-xmark"></i>
            Cancelar
        </a>
        <button type="submit" form="formReserva" class="btn btn-guardar">
            <i class="fa-regular fa-floppy-disk"></i> Guardar Reserva
        </button>
    </div>
</section>

<form id="formReserva" asp-action="GuardarReserva" method="post" class="reserva-layout">

    <input type="hidden" asp-for="Reserva.IdReserva" />

    <div class="reserva-main">

        <article class="card-reserva">
            <h2 class="card-title"><i class="fa-regular fa-calendar-check"></i> DATOS DE LA RESERVA</h2>

            <div class="form-grid-3">
                <div class="form-group">
                    <label asp-for="Reserva.FechaEntrada">Fecha de Entrada</label>
                    <input asp-for="Reserva.FechaEntrada" type="date" id="fechaEntrada" />
                </div>
                <div class="form-group">
                    <label asp-for="Reserva.FechaSalida">Fecha de Salida</label>
                    <input asp-for="Reserva.FechaSalida" type="date" id="fechaSalida" />
                </div>
                <div class="form-group">
                    <label asp-for="Reserva.CantidadPersonas">Cantidad Personas</label>
                    <input asp-for="Reserva.CantidadPersonas" id="cantPersonas" required min="1" />
                </div>

                <div class="form-group">
                    <label asp-for="Reserva.Estado">Estado</label>
                    <select asp-for="Reserva.Estado" class="form-control">
                        <option value="Pendiente">Pendiente</option>
                        <option value="Confirmada">Confirmada</option>
                        <option value="Cancelada">Cancelada</option>
                    </select>
                </div>
            </div>
        </article>

        <article class="card-reserva">
            <h2 class="card-title">
                <i class="fa-regular fa-user"></i>
                DATOS DEL CLIENTE
            </h2>
            <div class="form-grid-4">
                <div class="form-group">
                    <label asp-for="Reserva.IdCliente">
                        Cliente
                    </label>
                    <select asp-for="Reserva.IdCliente"
                            asp-items="@Model.ListaClientes"
                            class="form-control"
                            id="clienteSelect" required>
                        <option value="">
                            Seleccione un cliente
                        </option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Cliente.Dni">
                        DNI / Pasaporte
                    </label>
                    <input asp-for="Cliente.Dni"
                           id="clienteDni"
                           type="text"
                           placeholder="Documento"
                           readonly />
                </div>
                <div class="form-group">

                    <label asp-for="Cliente.Telefono">
                        Teléfono
                    </label>

                    <input asp-for="Cliente.Telefono"
                           id="clienteTelefono"
                           type="tel"
                           placeholder="Teléfono"
                           readonly />
                </div>
                <div class="form-group">
                    <label asp-for="Cliente.Email">
                        Email
                    </label>

                    <input asp-for="Cliente.Email"
                           id="clienteEmail"
                           type="email"
                           placeholder="Email"
                           readonly />
                </div>
            </div>
        </article>

        <article class="card-reserva">
            <h2 class="card-title"><i class="fa-solid fa-bed"></i> DETALLE DE LA HABITACIÓN</h2>

            <div class="form-grid-4">
                <div class="form-group">
                    <label asp-for="Reserva.TipoHabitacion">Tipo de Habitación</label>
                    <select asp-for="Reserva.TipoHabitacion" id="tipoHabitacionSelect" asp-items="@Model.ListaTipoHabitacion" class="form-control" required>
                        <option value="">Seleccione tipo</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Habitacion.Precio">Precio por Noche</label>
                    <input asp-for="Habitacion.Precio" id="precioHabitacion" type="text" placeholder="S/." />
                </div>
                <div class="form-group">
                    <label asp-for="Habitacion.Piso">Piso</label>
                    <input asp-for="Habitacion.Piso" type="text" placeholder="Piso" />
                </div>

                <div class="form-group">
                    <label asp-for="Reserva.IdHabitacion">Nro. de Habitación</label>
                    <select asp-for="Reserva.IdHabitacion" id="habitacionSelect" asp-items="@Model.ListaHabitaciones" class="form-control" required>
                        <option value="">Seleccione habitación</option>
                    </select>
                </div>
            </div>

            <div class="form-group mt-20">
                <label asp-for="Reserva.Observaciones">Observaciones</label>
                <textarea asp-for="Reserva.Observaciones" rows="3" placeholder="Ingrese observaciones adicionales..."></textarea>
            </div>
        </article>

    </div>

    <aside class="resumen-card">
        <h2 class="card-title">
            <i class="fa-regular fa-clipboard"></i> RESUMEN DE LA RESERVA
        </h2>

        <div class="resumen-item">
            <span>Habitación:</span>
            <strong id="lblHabitacion">--</strong>
        </div>

        <div class="resumen-item">
            <span>Tipo:</span>
            <strong id="lblTipo">--</strong>
        </div>

        <div class="resumen-item">
            <span>Entrada:</span>
            <strong id="lblEntrada">--</strong>
        </div>

        <div class="resumen-item">
            <span>Salida:</span>
            <strong id="lblSalida">--</strong>
        </div>

        <div class="resumen-item">
            <span>Noches:</span>
            <strong id="lblNoches">0</strong>
        </div>
        <div class="resumen-item">
            <span>Precio Por Noche:</span>
            <strong id="lblPrecioNoches">S/. 0.00</strong>
        </div>

        <div class="resumen-item"><span>Habitación:</span><strong id="lblHabitacion">--</strong></div>
        <div class="resumen-item"><span>Tipo:</span><strong id="lblTipo">--</strong></div>
        <div class="resumen-item"><span>Entrada:</span><strong id="lblEntrada">--</strong></div>
        <div class="resumen-item"><span>Salida:</span><strong id="lblSalida">--</strong></div>
        <div class="resumen-item"><span>Noches:</span><strong id="lblNoches">0</strong></div>
        <div class="resumen-item"><span>Personas:</span><strong id="lblPersonas">--</strong></div>

        <div class="total-final">
            <span>COSTO TOTAL:</span>
            <strong id="lblTotal">S/. 0.00</strong>
        </div>
    </aside>

</form>

<script src="~/js/JS_Reserva.js" asp-append-version="true"></script>