@* ============================================================
   VISTA: Nueva Reserva / Editar Reserva
   Detecta automáticamente el modo según Model.Reserva.IdReserva
   ============================================================ *@
@model HOTEL_PEA2.Models.ViewModels.ReservaViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool esEdicion = Model.Reserva != null && Model.Reserva.IdReserva > 0;
    ViewData["Title"] = esEdicion ? "Editar Reserva" : "Nueva Reserva";
}
<link rel="stylesheet" href="~/css/reserva.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />

<partial name="_Header" />

<section class="page-header">
    <div class="title-section">
        <div class="title-icon">
            <i class="fa-regular fa-calendar-days"></i>
        </div>
        <div>
            <h1>@(esEdicion ? $"Editar Reserva #{Model.Reserva.IdReserva}" : "Nueva Reserva")</h1>
            <nav class="breadcrumb">
                <span>Inicio</span> / <span>Reservas</span> /
                <strong>@(esEdicion ? "Editar" : "Nueva")</strong>
            </nav>
        </div>
    </div>

    <div class="header-buttons">
        <a asp-action="Index" class="btn btn-cancelar">
            <i class="fa-solid fa-xmark"></i> Cancelar
        </a>
        <button type="submit" form="formReserva" class="btn btn-guardar">
            <i class="fa-regular fa-floppy-disk"></i> @(esEdicion ? "Actualizar" : "Guardar Reserva")
        </button>
    </div>
</section>

<form id="formReserva" asp-action="GuardarReserva" method="post"
      class="reserva-layout" autocomplete="off">

    <input type="hidden" asp-for="Reserva.IdReserva" />
    <input type="hidden" asp-for="Reserva.CostoTotal" id="inputCostoTotal" />
    <input type="hidden" id="inputTipoCliente" name="TipoCliente" value="existente" />

    <div class="reserva-main">

        @* ============================================================
           SECCIÓN 1: DATOS DE LA RESERVA
           ============================================================ *@
        <article class="card-reserva">
            <h2 class="card-title">
                <i class="fa-regular fa-calendar-check"></i> DATOS DE LA RESERVA
            </h2>

            <div class="form-grid-3">
                <div class="form-group">
                    <label asp-for="Reserva.FechaEntrada">Fecha de Entrada</label>
                    <input asp-for="Reserva.FechaEntrada" type="date" id="fechaEntrada" />
                    <span asp-validation-for="Reserva.FechaEntrada" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Reserva.FechaSalida">Fecha de Salida</label>
                    <input asp-for="Reserva.FechaSalida" type="date" id="fechaSalida" />
                    <span asp-validation-for="Reserva.FechaSalida" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Reserva.CantidadPersonas">Cantidad Personas</label>
                    <input asp-for="Reserva.CantidadPersonas" id="cantPersonas"
                           type="number" required min="1" max="20" />
                </div>

                <div class="form-group">
                    <label asp-for="Reserva.Estado">Estado</label>
                    <select asp-for="Reserva.Estado" class="form-control">
                        <option value="Pendiente">Pendiente</option>
                        <option value="Confirmada">Confirmada</option>
                        <option value="Cancelada">Cancelada</option>
                    </select>
                </div>
            </div>
        </article>

        @* ============================================================
           SECCIÓN 2: DATOS DEL CLIENTE
           ============================================================ *@
        <article class="card-reserva">
            <h2 class="card-title">
                <i class="fa-regular fa-user"></i> DATOS DEL CLIENTE
            </h2>

            <div class="cliente-toggle">
                <label class="toggle-option">
                    <input type="radio" name="tipoClienteRadio" value="existente" checked />
                    <i class="fa-solid fa-users"></i>
                    <span>Cliente existente</span>
                </label>
                <label class="toggle-option">
                    <input type="radio" name="tipoClienteRadio" value="nuevo" />
                    <i class="fa-solid fa-user-plus"></i>
                    <span>Cliente nuevo</span>
                </label>
            </div>

            <div id="bloqueClienteExistente" class="mt-20">
                <div class="form-group">
                    <label for="clienteSelect">Seleccione un cliente</label>
                    @* Preselecciona el cliente actual si estamos editando *@
                    <select id="clienteSelect" name="Reserva.IdCliente"
                            class="form-control" autocomplete="off">
                        <option value="0">-- Seleccione un cliente --</option>
                        @if (ViewBag.ClientesData != null)
                        {
                            foreach (var c in ViewBag.ClientesData)
                            {
                                if (esEdicion && c.Id == Model.Reserva.IdCliente)
                                {
                                    <option value="@c.Id" selected
                                            data-dni="@c.Dni"
                                            data-nombre="@c.Nombre"
                                            data-telefono="@c.Telefono"
                                            data-email="@c.Email">
                                        @c.Nombre - @c.Dni
                                    </option>
                                }
                                else
                                {
                                    <option value="@c.Id"
                                            data-dni="@c.Dni"
                                            data-nombre="@c.Nombre"
                                            data-telefono="@c.Telefono"
                                            data-email="@c.Email">
                                        @c.Nombre - @c.Dni
                                    </option>
                                }
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="form-grid-4 mt-20">
                <div class="form-group">
                    <label asp-for="Cliente.Dni">DNI / Pasaporte</label>
                    <input asp-for="Cliente.Dni" id="clienteDni" type="text"
                           placeholder="Documento" readonly autocomplete="off" />
                </div>

                <div class="form-group">
                    <label asp-for="Cliente.Nombres">Nombre Completo</label>
                    <input asp-for="Cliente.Nombres" id="clienteNombre" type="text"
                           placeholder="Nombre completo" readonly autocomplete="off" />
                </div>

                <div class="form-group">
                    <label asp-for="Cliente.Telefono">Teléfono</label>
                    <input asp-for="Cliente.Telefono" id="clienteTelefono" type="tel"
                           placeholder="Teléfono" readonly autocomplete="off" />
                </div>

                <div class="form-group">
                    <label asp-for="Cliente.Email">Email</label>
                    <input asp-for="Cliente.Email" id="clienteEmail" type="email"
                           placeholder="Email" readonly autocomplete="off" />
                </div>
            </div>
        </article>

        @* ============================================================
           SECCIÓN 3: DETALLE DE LA HABITACIÓN
           ============================================================ *@
        <article class="card-reserva">
            <h2 class="card-title">
                <i class="fa-solid fa-bed"></i> DETALLE DE LA HABITACIÓN
            </h2>

            <div class="form-grid-4">
                <div class="form-group">
                    <label asp-for="Reserva.TipoHabitacion">Tipo de Habitación</label>
                    <select id="tipoHabitacionSelect" name="Reserva.TipoHabitacion"
                            class="form-control" required>
                        <option value="">-- Seleccione tipo --</option>
                        @if (Model.ListaTipoHabitacion != null)
                        {
                            foreach (var t in Model.ListaTipoHabitacion)
                            {
                                if (esEdicion && t.Text == Model.Reserva.TipoHabitacion)
                                {
                                    <option value="@t.Value" selected>@t.Text</option>
                                }
                                else
                                {
                                    <option value="@t.Value">@t.Text</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Habitacion.Precio">Precio por Noche</label>
                    <input asp-for="Habitacion.Precio" id="precioHabitacion" type="text"
                           placeholder="S/. 0.00" readonly />
                </div>

                <div class="form-group">
                    <label asp-for="Reserva.IdHabitacion">Nro. de Habitación</label>
                    <select id="habitacionSelect" name="Reserva.IdHabitacion"
                            required class="form-control" disabled>
                        <option value="">-- Primero elija un tipo --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Habitacion.Piso">Piso</label>
                    <input asp-for="Habitacion.Piso" id="pisoHabitacion" type="text"
                           placeholder="Piso" readonly />
                </div>
            </div>

            <div class="form-group mt-20">
                <label asp-for="Reserva.Observaciones">Observaciones</label>
                <textarea asp-for="Reserva.Observaciones" rows="3"
                          placeholder="Ingrese observaciones adicionales..."></textarea>
            </div>
        </article>

    </div>

    @* ============================================================
       COLUMNA DERECHA: RESUMEN
       ============================================================ *@
    <aside class="resumen-card">
        <h2 class="card-title">
            <i class="fa-regular fa-clipboard"></i> RESUMEN DE LA RESERVA
        </h2>

        <div class="resumen-item">
            <span>Habitación:</span>
            <strong id="lblHabitacion">--</strong>
        </div>
        <div class="resumen-item">
            <span>Tipo:</span>
            <strong id="lblTipo">--</strong>
        </div>
        <div class="resumen-item">
            <span>Entrada:</span>
            <strong id="lblEntrada">--</strong>
        </div>
        <div class="resumen-item">
            <span>Salida:</span>
            <strong id="lblSalida">--</strong>
        </div>
        <div class="resumen-item">
            <span>Noches:</span>
            <strong id="lblNoches">0</strong>
        </div>
        <div class="resumen-item">
            <span>Precio Por Noche:</span>
            <strong id="lblPrecioNoches">S/. 0.00</strong>
        </div>
        <div class="resumen-item">
            <span>Personas:</span>
            <strong id="lblPersonas">--</strong>
        </div>

        <div class="total-final">
            <span>COSTO TOTAL:</span>
            <strong id="lblTotal">S/. 0.00</strong>
        </div>
    </aside>

</form>

@* ============================================================
   DATOS PARA EL JAVASCRIPT
   ============================================================ *@
<script>
    const HABITACIONES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                ViewBag.HabitacionesData ?? new List<object>()));

    const RESERVAS_EXISTENTES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                ViewBag.ReservasExistentes ?? new List<object>()));

    const ID_RESERVA_ACTUAL = @(Model.Reserva?.IdReserva ?? 0);

    // ⬅️ NUEVO: datos actuales para que JS preseleccione al editar
    const ID_CLIENTE_ACTUAL    = @(Model.Reserva?.IdCliente ?? 0);
    const ID_HABITACION_ACTUAL = @(Model.Reserva?.IdHabitacion ?? 0);
</script>

<script src="~/js/JS_Reserva.js" asp-append-version="true"></script>