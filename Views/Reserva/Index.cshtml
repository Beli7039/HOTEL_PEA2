@model IEnumerable<HOTEL_PEA2.Models.Reserva>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Listado de Reservas";
}

<link rel="stylesheet" href="~/css/reserva.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />

<partial name="_Header" />

<div class="panel">
    <div class="dashboard-header">
        <div>
            <h1>Listado de Reservas</h1>
            <p>Gestión y administración de reservas registradas</p>
        </div>
    </div>

    <!-- =========================
         AGREGAR RESERVA
         ========================= -->
    <div class="reserva-toolbar">
        <a asp-action="NuevaReserva"
           class="btn btn-agregar">
            <i class="fa-solid fa-plus"></i>
            Agregar Reserva
        </a>
    </div>

    <!-- =========================
         BUSCADOR
         ========================= -->
    <form asp-action="Index"
          method="get"
          class="reserva-search">
        <label>
            Buscar:
        </label>
        <input type="text"
               name="criterio"
               placeholder="Ingrese nombre o apellido..." />
        <button type="submit"
                class="btn btn-sm btn-buscar">
            <i class="fa-solid fa-magnifying-glass"></i>
            Buscar
        </button>
    </form>
    <!-- =========================
         TABLA
         ========================= -->
    <div class="tabla-container">
        <table class="tabla-reservas">
            <thead>
                <tr>
                    <th>
                        Nombre del Cliente
                    </th>
                    <th>
                        Documento
                    </th>
                    <th>
                        Fecha Entrada
                    </th>
                    <th>
                        Fecha Salida
                    </th>
                    <th>
                        Estado
                    </th>
                    <th class="columna-acciones">
                        Acciones
                    </th>
                </tr>
            </thead>
            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="cliente">
                                @(item.Cliente != null
                                                        ? item.Cliente.Nombres + " " + item.Cliente.Apellidos
                                                        : "Sin Cliente")
                             </td>
                             <td class="cliente">
                                 @(item.Cliente!= null ? item.Cliente.Dni : "")
                             </td>

                            <td class="fecha">
                                @item.FechaEntrada.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                            <td class="fecha">
                                @item.FechaSalida.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                            <td class="estado">
                                @item.Estado
                            </td>
                            <td>
                                <div class="acciones">
                                    <!-- EDITAR -->
                                    <a asp-action="NuevaReserva"
                                       asp-route-id="@item.IdReserva"
                                       class="btn btn-sm btn-modificar">

                                        <i class="fa-solid fa-pen-to-square"></i>
                                        Editar

                                    </a>


                                    <!-- ELIMINAR -->

                                    <form asp-action="Eliminar"
                                          asp-route-id="@item.IdReserva"
                                          method="post">

                                        <button type="submit"
                                                class="btn btn-sm btn-eliminar"
                                                onclick="return confirm('¿Estás seguro de eliminar esta reserva?');">

                                            <i class="fa-solid fa-trash"></i>
                                            Eliminar

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                                }
                }
                else
                {
                    <tr>

                        <td colspan="4" class="sin-registros">

                            No hay registros disponibles.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
