@model IEnumerable<HOTEL_PEA2.Models.Habitacion>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Habitaciones";
}

<link rel="stylesheet" href="~/css/habitaciones.css" asp-append-version="true" />

<div class="habitaciones-container">

    <div class="habitaciones-header">
        <div class="titulo">
            <div class="icon-header">
                <i class="fa-solid fa-bed"></i>
            </div>
            <div>
                <h1>Habitaciones</h1>
                <p>Inicio / Habitaciones</p>
            </div>
        </div>
        <a asp-action="Create" class="btn-nuevo">
            <i class="fa-solid fa-plus"></i> Nueva Habitación
        </a>
    </div>

    <div class="card">
        <div class="card-title">LISTA DE HABITACIONES</div>

        @if (!Model.Any())
        {
            <div class="sin-registros">
                <i class="fa-solid fa-inbox"></i>
                <p>No hay habitaciones registradas.</p>
            </div>
        }
        else
        {
            <div class="tabla-wrapper">
                <table class="tabla-habitaciones">
                    <thead>
                        <tr>
                            <th class="col-id">ID</th>
                            <th class="col-numero">Número</th>
                            <th class="col-piso">Piso</th>
                            <th class="col-capacidad">Capacidad</th>
                            <th class="col-precio">Precio</th>
                            <th class="col-tipo">Tipo</th>
                            <th class="col-estado">Estado</th>
                            <th class="col-acciones">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model)
                        {
                            <tr>
                                <td class="col-id">@h.IdHabitacion</td>
                                <td class="col-numero">
                                    <span class="numero-badge">@h.Numero</span>
                                </td>
                                <td class="col-piso">@h.Piso</td>
                                <td class="col-capacidad">@h.Capacidad</td>
                                <td class="col-precio">
                                    S/. @h.Precio.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
                                </td>
                                <td class="col-tipo">@h.TipoHabitacion?.NombreTipo</td>
                                <td class="col-estado">
                                    <span class="estado-badge estado-@(h.Estado?.ToLower())">
                                        @h.Estado
                                    </span>
                                </td>
                                <td class="col-acciones">
                                    <div class="acciones">
                                        <a asp-action="Edit" asp-route-id="@h.IdHabitacion"
                                           class="btn-accion btn-editar" title="Editar">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@h.IdHabitacion"
                                           class="btn-accion btn-detalle" title="Ver detalles">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@h.IdHabitacion"
                                           class="btn-accion btn-eliminar" title="Eliminar">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>