@model HOTEL_PEA2.Models.Habitacion
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Detalles de Habitación";
}
<link rel="stylesheet" href="~/css/habitaciones.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/botones.css" asp-append-version="true" />

<div class="habitaciones-container">

    @* ============================================================
       ENCABEZADO
       ============================================================ *@
    <div class="habitaciones-header">
        <div class="titulo">
            <div class="icon-header" style="background:#0d6efd;">
                <i class="fa-solid fa-eye"></i>
            </div>
            <div>
                <h1>Detalles de Habitación</h1>
                <p>Inicio / Habitaciones / <strong>Habitación #@Model.IdHabitacion</strong></p>
            </div>
        </div>
        <a asp-action="Index" class="btn-cancelar-top">
            <i class="fa-solid fa-arrow-left"></i> Volver al listado
        </a>
    </div>

    @* ============================================================
       TARJETA DE DETALLES
       ============================================================ *@
    <div class="card form-card">
        <div class="card-title">
            <i class="fa-solid fa-bed"></i> HABITACIÓN #@Model.IdHabitacion
        </div>

        @* --- Estado destacado arriba --- *@
        <div class="detalle-estado">
            <span class="estado-badge estado-@(Model.Estado?.ToLower())">
                <i class="fa-solid fa-circle-check"></i> @Model.Estado
            </span>
        </div>

        @* --- Grid de información --- *@
        <div class="detalles-grid">

            <div class="detalle-item">
                <div class="detalle-icon">
                    <i class="fa-solid fa-hashtag"></i>
                </div>
                <div class="detalle-info">
                    <span class="detalle-label">ID</span>
                    <strong class="detalle-valor">@Model.IdHabitacion</strong>
                </div>
            </div>

            <div class="detalle-item">
                <div class="detalle-icon">
                    <i class="fa-solid fa-door-closed"></i>
                </div>
                <div class="detalle-info">
                    <span class="detalle-label">Número</span>
                    <strong class="detalle-valor">@Model.Numero</strong>
                </div>
            </div>

            <div class="detalle-item">
                <div class="detalle-icon">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <div class="detalle-info">
                    <span class="detalle-label">Piso</span>
                    <strong class="detalle-valor">@Model.Piso</strong>
                </div>
            </div>

            <div class="detalle-item">
                <div class="detalle-icon">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div class="detalle-info">
                    <span class="detalle-label">Capacidad</span>
                    <strong class="detalle-valor">@Model.Capacidad personas</strong>
                </div>
            </div>

            <div class="detalle-item">
                <div class="detalle-icon">
                    <i class="fa-solid fa-tag"></i>
                </div>
                <div class="detalle-info">
                    <span class="detalle-label">Tipo de Habitación</span>
                    <strong class="detalle-valor">
                        @(Model.TipoHabitacion?.NombreTipo ?? "—")
                    </strong>
                </div>
            </div>

            <div class="detalle-item detalle-precio">
                <div class="detalle-icon">
                    <i class="fa-solid fa-money-bill-wave"></i>
                </div>
                <div class="detalle-info">
                    <span class="detalle-label">Precio por Noche</span>
                    <strong class="detalle-valor precio-destacado">
                        S/. @Model.Precio.ToString("F2")
                    </strong>
                </div>
            </div>

        </div>

        @* --- Acciones --- *@
        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.IdHabitacion" class="btn-guardar">
                <i class="fa-solid fa-pen-to-square"></i> Editar Habitación
            </a>
        </div>
    </div>

</div>